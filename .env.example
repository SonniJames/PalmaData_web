# ============================================
# PalmaData · Variables de entorno
# Copia como .env y pon los valores reales.
# El .env NUNCA se sube a GitHub.
# ============================================

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nombre_de_tu_base
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# --- Tabla de usuarios (ajusta a tu esquema real) ---
# Esquema y tabla donde viven los usuarios reciclados
AUTH_SCHEMA=plantacion
AUTH_TABLE=usuario
# Columna que identifica al usuario (lo que se escribe en el login)
AUTH_USER_COL=usuario
# Columna con el hash de contraseña de PalmaData
AUTH_PASS_COL=password_palmadata
# Columna opcional con el nombre a mostrar (déjala igual a AUTH_USER_COL si no hay)
AUTH_NAME_COL=nombre

# --- Aplicación ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Clave para firmar las cookies de sesión (cámbiala por una larga y aleatoria)
SECRET_KEY=pon-aqui-una-cadena-larga-y-aleatoria-cambiala
# Minutos de duración de la sesión
SESSION_MINUTES=480
